
# ============================================================
# SIGNORA AI — Environment Configuration
# ============================================================
#
# Project: SIGNORA AI
# Framework: Next.js 15
# Deployment: Static export
# Design specification: design.md
#
# The website is a static cinematic experience.
# No environment variables are required to run it locally.
#
# Copy this file to .env.local only when you need to configure
# the optional values below.
#
# IMPORTANT:
# Variables prefixed with NEXT_PUBLIC_ are exposed in the
# browser bundle. Never store API keys, tokens, passwords,
# or other secrets in these variables.
# ============================================================


# ------------------------------------------------------------
# 1. PUBLIC WEBSITE URL
# ------------------------------------------------------------
#
# Optional.
# Set only after the official production domain is confirmed.
#
# Used for canonical URLs and social-sharing metadata
# if configured in the application.
#
# NEXT_PUBLIC_SITE_URL=https://your-approved-domain.example


# ------------------------------------------------------------
# 2. PUBLIC CONTACT EMAIL
# ------------------------------------------------------------
#
# Optional.
# Use only a verified and approved contact address.
#
# The static partnership form will use a mailto flow.
# It must not claim to have submitted or stored a message.
#
# NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com


# ------------------------------------------------------------
# 3. MEDIA ASSETS
# ------------------------------------------------------------
#
# Railway animation, illustrations, and other media should
# be stored locally under /public/media or /public/images.
#
# No external video-service API key is required.
#
# The optional 10-second cinematic hero video must have
# a web-native, accessible fallback.
#
# Audio remains disabled until the visitor opts in.


# ------------------------------------------------------------
# 4. FUTURE INTEGRATIONS
# ------------------------------------------------------------
#
# No production AI API, database, payment, analytics,
# contact-form backend, or authentication service is
# configured for this static website.
#
# Do not introduce fake endpoints or submission states.
#
# Future services must be implemented and configured
# separately before being advertised as operational.


# ============================================================
# END OF ENVIRONMENT CONFIGURATION
# ============================================================
