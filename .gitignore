
# ==========================================================
# SIGNORA AI — Git Ignore
# Next.js 15 | TypeScript | GSAP | Static Export
# Design reference: design.md
# ==========================================================

# Dependencies
/node_modules/
/.pnp
.pnp.*
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/versions

# Next.js build outputs
/.next/
/out/
/build/
/dist/

# Deployment platforms
/.vercel/
.netlify/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# TypeScript generated files
*.tsbuildinfo
next-env.d.ts

# Testing and coverage
/coverage/
/test-results/
/playwright-report/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# IDE and editor settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary files
/tmp/
/temp/
*.tmp
*.temp
.cache/

# Local backups
*.bak
*.backup
*.orig

# Archives generated for delivery
*.zip
*.tar
*.tar.gz

# Keep design documentation, source assets,
# public media and package lockfiles versioned.
